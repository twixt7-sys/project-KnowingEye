# Same-origin path (recommended for local/LAN). Vite proxies /api and /ws to Django.
# Works on any network without changing this file when your LAN IP changes.
VITE_API_BASE_URL=/api

# Absolute URL only when the API is hosted separately (e.g. production):
# VITE_API_BASE_URL=https://api.example.com/api

VITE_APP_NAME=Knowing Eye

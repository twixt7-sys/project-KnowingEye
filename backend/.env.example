# --- Django ---
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
# Development overrides this to * when DJANGO_DEBUG=True (any LAN IP works).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_TIME_ZONE=UTC

# --- Database ---
# Use SQLite for development; PostgreSQL in production.
DB_ENGINE=django.db.backends.sqlite3
# DB_ENGINE=django.db.backends.postgresql
DB_NAME=knowing_eye
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT ---
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=7

# --- Channels (set REDIS_URL to use Redis layer in production) ---
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Knowing Eye AI pipeline ---
KE_ENABLE_PIPELINE=True
KE_ALERT_THRESHOLD=80
KE_STORE_FRAMES=False

# --- Seed administrator (consumed by `python manage.py seed_db`) ---
# Provisions the bootstrap admin account (id=1). Override these in your local
# .env; do not commit real credentials. Defaults (admin / adminpass) are used
# when unset, for dev convenience only.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@knowingeye.test
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# --- Supabase (optional; sends OTP/transactional email via an Edge Function) ---
# Leave both blank to keep the console backend in development / SMTP in
# production - OTP codes are printed to the server log/console instead of
# emailed, which is enough to test the flow locally. Set BOTH (a blank
# secret is rejected and the console/SMTP backend is used instead) to send
# real email through supabase/functions/send-email. See docs/backend for how
# to create the project, deploy the function, and set its RESEND_API_KEY /
# OTP_FUNCTION_SECRET secrets.
SUPABASE_URL=
SUPABASE_OTP_FUNCTION_SECRET=
# Sender address for mail relayed through the edge function. Leave blank to
# use the function's own RESEND_FROM_EMAIL/onboarding@resend.dev default -
# only set this to an address verified with Resend, otherwise every send
# will be rejected.
SUPABASE_FROM_EMAIL=

# --- OTP / email verification ---
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Dev/test only: echoes the plaintext OTP code back on the verify-email
# request endpoint (as "debug_code") so it can be verified with no working
# mail transport at all. Only takes effect when DJANGO_DEBUG is also True.
# Never enable this against a real deployment.
OTP_DEBUG_RETURN_CODE=False
